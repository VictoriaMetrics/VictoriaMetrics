          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "Time": 0,
              "Value #A": 3,
              "Value #B": 4,
              "alertname": 2,
              "group": 1
            },
            "renameByName": {
              "Value #A": "Count",
